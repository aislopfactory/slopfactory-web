---
/**
 * The one place game media lives. Use it anywhere a screenshot, clip or trailer should go.
 *
 *   <MediaSlot kind="image"   src="/media/foo.jpg" alt="…" />
 *   <MediaSlot kind="video"   src="/media/foo.mp4" poster="/media/foo.jpg" />
 *   <MediaSlot kind="youtube" src="VIDEO_ID" title="Trailer" />   (privacy-friendly nocookie embed)
 *   <MediaSlot kind="trailer" label="Trailer" note="Not ready. Not slop." />  ← empty placeholder
 */
interface Props {
  kind?: 'image' | 'video' | 'youtube' | 'trailer' | 'shot';
  src?: string;
  poster?: string;
  alt?: string;
  title?: string;
  label?: string;
  note?: string;
  class?: string;
}
const { kind = 'shot', src, poster, alt = '', title = '', label = '', note = '', class: cls = '' } = Astro.props;
---
<figure class:list={['media', { 'media--empty': !src }, cls]} style="margin:0">
  {kind === 'image' && src && <img src={src} alt={alt} loading="lazy" decoding="async" />}
  {kind === 'video' && src && <video src={src} poster={poster} controls preload="metadata" playsinline />}
  {kind === 'youtube' && src && (
    <iframe src={`https://www.youtube-nocookie.com/embed/${src}`} title={title} loading="lazy" allow="accelerometer; encrypted-media; picture-in-picture; fullscreen" allowfullscreen />
  )}
  {!src && (
    <>
      <span class="tag mono">{label}</span>
      <div>
        {kind === 'trailer' && <div class="play" aria-hidden="true"></div>}
        <span class="soon">{note}</span>
      </div>
    </>
  )}
</figure>
