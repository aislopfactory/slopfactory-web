---
import { ui, langLabel, langShort, languages, type Lang } from '../i18n/ui';
interface Props { lang: Lang; altHref: Record<Lang, string>; current?: 'about' | 'work' | 'blog' | '' }
const { lang, altHref, current = '' } = Astro.props;
const t = ui[lang];
const base = `/${lang}/`;
---
<a class="skip mono" href="#main">{t.skip}</a>
<header class="head">
  <div class="wrap bar">
    <a class="logo" href={base} aria-label={`${t.siteTitle} — ${t.a11y.home}`}>
      <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
        <rect x="1.5" y="1.5" width="29" height="29" fill="var(--ink)" />
        <path d="M8 22 L8 10 L13 14 L13 10 L18 14 L18 10 L24 10 L24 22 Z" fill="var(--paper)" />
        <rect x="19.5" y="5" width="3" height="5" fill="var(--signal)" />
      </svg>
      <span class="display name">{lang === 'en' ? <>Slop<br />Factory</> : t.siteTitle}</span>
    </a>
    <nav aria-label={t.a11y.primaryNav} class="nav mono">
      <a href={`${base}#studio`} aria-current={current === 'about' ? 'page' : undefined}>{t.nav.about}</a>
      <a href={`${base}#games`} aria-current={current === 'work' ? 'page' : undefined}>{t.nav.work}</a>
      <a href={`${base}blog/`} aria-current={current === 'blog' ? 'page' : undefined}>{t.nav.blog}</a>
    </nav>
    <div class="lang" role="group" aria-label="Language / 언어">
      {languages.map((l) => (
        <a href={altHref[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={langLabel[l]} class="mono" data-lang-switch={l}>{langShort[l]}</a>
      ))}
    </div>
  </div>
</header>
<script>
  // Remember an explicit language choice so the root redirect honours it.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) =>
    a.addEventListener('click', () => { try { localStorage.setItem('sf-lang', a.dataset.langSwitch!); } catch {} }),
  );
</script>
<style>
  .skip { position: absolute; left: -999px; top: 0; background: var(--signal); color: var(--signal-ink); padding: .6rem 1rem; z-index: 100; }
  .skip:focus { left: 0; }
  .head { position: sticky; top: 0; z-index: 50; background: var(--paper); border-bottom: var(--rule); }
  .bar { display: flex; align-items: center; gap: 1rem; padding-block: .65rem; }
  .logo { display: flex; align-items: center; gap: .65rem; text-decoration: none; margin-right: auto; }
  .name { font-size: 1rem; line-height: .88; letter-spacing: -0.03em; text-transform: uppercase; }
  :global(:lang(ko)) .name { text-transform: none; font-size: 1.15rem; line-height: 1; }
  .nav { display: flex; gap: clamp(.9rem, 3vw, 2rem); }
  .nav a { text-decoration: none; padding: .3rem 0; border-bottom: 2px solid transparent; }
  .nav a:hover, .nav a[aria-current='page'] { border-bottom-color: var(--signal); }
  :global(:lang(ko)) .nav { font-size: .92rem; font-family: var(--f-body); font-weight: 600; }
  .lang { display: flex; border: var(--rule); }
  .lang a { text-decoration: none; padding: .35rem .65rem; font-weight: 600; }
  .lang a + a { border-left: var(--rule); }
  .lang a[aria-current='true'] { background: var(--ink); color: var(--paper); }
  .lang a:not([aria-current]):hover { background: var(--signal); color: var(--signal-ink); }
  @media (max-width: 640px) {
    .bar { flex-wrap: wrap; row-gap: .5rem; }
    .nav { order: 3; width: 100%; justify-content: space-between; border-top: 1px solid rgba(21,19,15,.25); padding-top: .4rem; }
  }
</style>
