---
// Rotating "NOT SLOP" inspection stamp. Pure SVG + CSS, respects prefers-reduced-motion.
interface Props { top: string; mid: string; bottom: string }
const { top, mid, bottom } = Astro.props;
const ring = `${top} • ${mid} • ${bottom} • ${top} • ${mid} • ${bottom} • `;
---
<div class="stamp" role="img" aria-label={`${mid}`}>
  <svg viewBox="0 0 200 200" class="ring" aria-hidden="true">
    <defs><path id="circ" d="M100,100 m-80,0 a80,80 0 1,1 160,0 a80,80 0 1,1 -160,0" /></defs>
    <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="3" />
    <circle cx="100" cy="100" r="62" fill="none" stroke="currentColor" stroke-width="2" />
    <text font-size="13" letter-spacing="3.2" fill="currentColor" font-weight="700"><textPath href="#circ" textLength="496" lengthAdjust="spacingAndGlyphs">{ring}</textPath></text>
  </svg>
  <div class="core">
    <span class="mono">{top}</span>
    <strong class="display">{mid}</strong>
    <span class="mono">{bottom}</span>
  </div>
</div>
<style>
  .stamp { position: relative; width: clamp(190px, 26vw, 300px); aspect-ratio: 1; color: var(--signal); transform: rotate(-9deg); mix-blend-mode: multiply; flex: none; }
  .ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 40s linear infinite; }
  .core { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; gap: .15rem; }
  .core strong { font-size: clamp(1.7rem, 3.2vw, 2.6rem); line-height: .9; text-transform: uppercase; }
  :global(:lang(ko)) .core strong { text-transform: none; font-size: clamp(1.5rem, 2.8vw, 2.2rem); }
  .core .mono { font-size: .62rem; font-weight: 600; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .ring { animation: none; } }
</style>
