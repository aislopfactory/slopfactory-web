---
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import MediaSlot from '../../components/MediaSlot.astro';
import PostCard from '../../components/PostCard.astro';
import { ui, languages, type Lang } from '../../i18n/ui';
import { getPosts } from '../../i18n/posts';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const posts = (await getPosts(lang)).slice(0, 3);
const ticker = Array.from({ length: 10 }, () => t.ticker);
---
<Base lang={lang} altHref={{ en: '/en/', ko: '/ko/' }}>
  <section class="hero wrap">
    <div class="copy">
      <p class="mono kicker">{t.hero.kicker}</p>
      <h1 class="display h1">
        <span class="l1">{t.hero.line1}</span>
        <span class="l2"><span class="strike">{t.hero.line2}</span></span>
      </h1>
      <p class="lede">{t.hero.lede}</p>
      <div class="cta">
        <a class="btn btn--primary" href={`/${lang}/blog/`}>{t.hero.ctaPrimary} <span class="arr">→</span></a>
        <a class="btn" href="#studio">{t.hero.ctaSecondary}</a>
      </div>
    </div>
    <div class="stampwrap"><Stamp top={t.hero.stampTop} mid={t.hero.stampMid} bottom={t.hero.stampBot} /></div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="track display">{[...ticker, ...ticker].map((x) => <span>{x}<i></i></span>)}</div>
  </div>

  <section class="wrap sec" id="promise">
    <p class="mono kicker">{t.promise.kicker}</p>
    <h2 class="display h2">{t.promise.title}</h2>
    <ol class="rules">
      {t.promise.items.map((i) => (
        <li><span class="mono n">{i.n}</span><h3 class="display">{i.title}</h3><p>{i.body}</p></li>
      ))}
    </ol>
  </section>

  <section class="wrap sec" id="games">
    <p class="mono kicker">{t.work.kicker}</p>
    <h2 class="display h2">{t.work.title}</h2>
    <p class="lede">{t.work.lede}</p>
    <div class="reel">
      <MediaSlot kind="trailer" label={t.work.trailer} note={t.work.soon} class="big" />
      <MediaSlot kind="shot" label={`${t.work.shot} 01`} note={t.work.soon} />
      <MediaSlot kind="shot" label={`${t.work.shot} 02`} note={t.work.soon} />
    </div>
  </section>

  <section class="about" id="studio">
    <div class="wrap sec grid">
      <div>
        <p class="mono kicker">{t.about.kicker}</p>
        <h2 class="display h2">{t.about.title}</h2>
      </div>
      <div class="body">
        {t.about.body.map((p) => <p>{p}</p>)}
        <dl class="facts">
          {t.about.facts.map((f) => <div><dt class="mono">{f.k}</dt><dd>{f.v}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="wrap sec" id="blog">
    <div class="sechead">
      <div><p class="mono kicker">{t.blog.kicker}</p><h2 class="display h2">{t.blog.latest}</h2></div>
      <a class="btn" href={`/${lang}/blog/`}>{t.blog.all} <span class="arr">→</span></a>
    </div>
    {posts.length ? <div>{posts.map((p, i) => <PostCard post={p} lang={lang} index={i} />)}</div> : <p class="empty">{t.blog.empty}</p>}
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2rem; padding-block: clamp(2.5rem, 7vw, 6rem) clamp(2.5rem, 6vw, 5rem); }
  .kicker { margin: 0 0 1.4rem; }
  .h1 { font-size: clamp(3.2rem, 11.5vw, 10rem); margin-bottom: 1.8rem; }
  .h1 .l1, .h1 .l2 { display: block; }
  .strike { position: relative; color: var(--signal); display: inline-block; }
  :global(:lang(ko)) .h1 { font-size: clamp(2.6rem, 8.6vw, 7.2rem); }
  .lede { font-size: clamp(1.05rem, 1rem + .5vw, 1.35rem); max-width: 46ch; color: var(--ink-soft); margin: 0 0 2rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 1rem; }
  .stampwrap { padding-right: 1rem; }
  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; } .stampwrap { order: -1; justify-self: end; margin-bottom: -2rem; } }

  .ticker { background: var(--signal); color: var(--ink); border-block: var(--rule); overflow: hidden; white-space: nowrap; }
  .track { display: inline-flex; animation: roll 28s linear infinite; font-size: clamp(1.4rem, 3.5vw, 2.4rem); text-transform: uppercase; line-height: 1; padding-block: .75rem; letter-spacing: -0.02em; }
  :global(:lang(ko)) .track { text-transform: none; line-height: 1.2; }
  .track span { padding-right: 1.2rem; display: inline-flex; gap: 1.2rem; }
  .track i { width: .45em; height: .45em; background: var(--ink); transform: rotate(45deg); align-self: center; margin-left: .4rem; }
  @keyframes roll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }

  .sec { padding-block: clamp(3.5rem, 8vw, 7rem) 0; }
  .h2 { font-size: clamp(2.2rem, 6vw, 4.6rem); margin-bottom: 2rem; max-width: 18ch; }
  :global(:lang(ko)) .h2 { max-width: 20ch; font-size: clamp(1.9rem, 5vw, 3.8rem); }
  .rules { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border: var(--rule); background: var(--paper); }
  .rules li { padding: 1.6rem; display: grid; gap: .6rem; align-content: start; }
  .rules li + li { border-left: var(--rule); }
  .rules h3 { font-size: 1.7rem; line-height: 1.05; }
  :global(:lang(ko)) .rules h3 { line-height: 1.25; font-size: 1.5rem; }
  .rules p { margin: 0; color: var(--ink-soft); }
  .n { color: var(--signal); font-weight: 600; }
  @media (max-width: 800px) { .rules { grid-template-columns: 1fr; } .rules li + li { border-left: 0; border-top: var(--rule); } }

  .reel { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; margin-top: 2.4rem; }
  .reel :global(.big) { grid-column: 1 / -1; }
  @media (max-width: 640px) { .reel { grid-template-columns: 1fr; } }

  .about { background: var(--paper-2); border-block: var(--rule); margin-top: clamp(3.5rem, 8vw, 7rem); padding-bottom: clamp(3.5rem, 8vw, 6rem); }
  .about .sec { padding-top: clamp(3rem, 7vw, 6rem); }
  .grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(1.5rem, 5vw, 4rem); }
  .body p { margin: 0 0 1.1rem; max-width: 58ch; }
  .facts { margin: 2rem 0 0; display: grid; grid-template-columns: 1fr 1fr; border: var(--rule); background: var(--paper); }
  .facts div { padding: .9rem 1rem; border-bottom: 1px solid rgba(21,19,15,.25); }
  .facts div:nth-child(odd) { border-right: 1px solid rgba(21,19,15,.25); }
  .facts div:nth-last-child(-n+2) { border-bottom: 0; }
  .facts dt { color: var(--signal); font-weight: 600; margin-bottom: .2rem; }
  .facts dd { margin: 0; font-weight: 600; }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } .h2 { max-width: none; } }

  .sechead { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .sechead .h2 { margin-bottom: 0; }
  .empty { border: var(--rule); border-style: dashed; padding: 2rem; margin: 0; }
</style>
