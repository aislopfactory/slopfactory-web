---
// Root: send visitors to /en/ or /ko/. Static hosting can't do Accept-Language, so do it client-side,
// with a <meta refresh> + link fallback for no-JS (defaults to English).
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Slop Factory · 슬롭 팩토리</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href="/en/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="ko" href="/ko/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var saved; try { saved = localStorage.getItem('sf-lang'); } catch (e) {}
        var pref = saved || ((navigator.languages && navigator.languages[0]) || navigator.language || 'en');
        location.replace(String(pref).toLowerCase().indexOf('ko') === 0 ? '/ko/' : '/en/');
      })();
    </script>
  </head>
  <body><p><a href="/en/">English</a> · <a href="/ko/">한국어</a></p></body>
</html>
